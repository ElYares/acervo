# Copiar a `.env` en la raiz del repo:  cp .env.example .env
#
# Un solo archivo para todo el proyecto. Compose lo lee solo, porque el
# `compose.yaml` que resuelve devherd es el de la raiz y ahi es donde Compose
# busca su `.env`. Los servicios de Python lo cargan con `python-dotenv`,
# buscandolo hacia arriba desde el codigo, para no depender de desde donde se
# lance el proceso.
#
# Los valores de abajo son los de desarrollo local contra el compose de
# `infra/`. No son secretos reales, pero el codigo ya no los conoce: sin este
# archivo, `ingest` falla nombrando la variable que falta.

# --- Obligatorias ---

MINIO_ROOT_USER=acervo
MINIO_ROOT_PASSWORD=acervo123

# Origen de TLC. Obligatoria a proposito: ninguna URL del origen vive en el
# codigo. Verificada con peticiones HEAD reales el 2026-08-04.
ACERVO_TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data

# --- Opcionales: el default esta a la derecha ---

# ACERVO_S3_ENDPOINT=http://localhost:9000
# ACERVO_S3_REGION=us-east-1
# ACERVO_S3_BUCKET_RAW=raw
# ACERVO_HTTP_TIMEOUT=30
